table Crime
	lineageTag: 18d428d0-1c27-4027-ba34-4500fb93dae9

	measure 'Total Crime Count' = COUNTROWS(Crime)
		formatString: 0
		lineageTag: a8c42c5e-fa12-49b2-aaea-440c9f05b174

	measure 'Total Crime (Unfiltered)' = CALCULATE(CountRows(Crime), ALL(Crime[Local Authority Name]), ALL('Date'), ALL(Crime[Crime type]))
		formatString: 0
		lineageTag: 5873acf1-17a9-47f0-b75f-52b78e8818b4

	measure 'Crime Rate (Per 1000)' = DIVIDE([Total Crime Count],SUM('Population'[Population]))*1000
		lineageTag: 216435ba-0c1b-466f-a718-ef22cf4e97d1

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure '% Total Crime' = DIVIDE([Total Crime Count], [Total Crime (Unfiltered)])
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: c6d55548-a513-4f3d-b256-629fdb0d6703

	measure '12 Month Rolling Average' = ```
			
			VAR _EndDate = Max('Date'[Month & Year])
			VAR _12MonthsAgo = EOMONTH(_EndDate, -12)
			VAR _StartDate = Date(Year(_12MonthsAgo), month(_12MonthsAgo),1)
			VAR _Table =
			    Summarize(
			        Filter(All('Date'),[Month & Year] >= _StartDate && [Month & Year] <= _EndDate),
			        'Date'[Month & Year],
			        "_value",'Crime'[Total Crime Count]) 
			Return
			    AverageX(_table,'Crime'[Total Crime Count])
			```
		lineageTag: f7640135-d98b-4c5d-869d-0be7d4757531

		annotation PBI_FormatHint = {"isGeneralNumber":true}

